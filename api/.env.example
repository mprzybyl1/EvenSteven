# Skopiuj do .env i uzupełnij. NIE commituj .env!
NODE_ENV=development

# Dev: SQLite (plik). Prod: postgresql://user:pass@host:5432/evensteven
DATABASE_URL="file:./dev.db"

# Sekrety — w prod wygeneruj długie losowe (np. openssl rand -hex 32)
JWT_SECRET="dev-zmien-mnie-na-cos-dlugiego-i-losowego-min-32-znaki"
COOKIE_SECRET="dev-tez-mnie-zmien-cos-innego-dlugiego-32-znaki"

PORT=3001
# Skąd wpuszczamy front (CORS). Dev: Vite na 5173.
CORS_ORIGIN="http://localhost:5173"

# Web Push (VAPID) — wygeneruj raz: npx web-push generate-vapid-keys
# Bez tych kluczy push jest po prostu wyłączony (apka działa normalnie).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:ty@twojadomena.pl"
