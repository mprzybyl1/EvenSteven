# Buduje frontend (Vite) i wypieka statyk do obrazu Caddy.
# Kontekst budowania = katalog repo (potrzebny dostęp do web/).
FROM node:22-alpine AS build
WORKDIR /app
COPY web/package*.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM caddy:2-alpine
# Caddyfile montujemy z repo (łatwe tweaki bez rebuildu), dist wypieczone w obrazie.
COPY --from=build /app/dist /srv/web
