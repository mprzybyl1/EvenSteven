# Produkcja — skopiuj do .env.prod i uzupełnij. NIE commituj .env.prod!
DOMAIN=evensteven.twojadomena.pl

POSTGRES_USER=evensteven
POSTGRES_PASSWORD=ZMIEN_NA_DLUGIE_LOSOWE
POSTGRES_DB=evensteven

# openssl rand -hex 32
JWT_SECRET=ZMIEN_NA_DLUGIE_LOSOWE_MIN_32_ZNAKI
COOKIE_SECRET=ZMIEN_NA_INNE_DLUGIE_LOSOWE_32_ZNAKI

# Web Push — wygeneruj raz: docker run --rm node:22-alpine npx -y web-push generate-vapid-keys
# (albo lokalnie: npx web-push generate-vapid-keys). Bez tego push jest wyłączony.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ty@twojadomena.pl

# Mail (zaproszenia) przez Gmail SMTP. Bez kompletu — mail wyłączony (zaproszenia
# i tak da się rozsyłać linkiem). GMAIL_APP_PASSWORD = hasło aplikacji Google (2FA wymagane):
# https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# APP_ORIGIN ustawia się automatycznie na https://${DOMAIN} w docker-compose.yml.
